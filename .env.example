# Copy to `.env` (gitignored, mode 0600) and fill in. Variable names only — never
# a value: tests/unit/architecture/integrity.test.ts fails if a key-shaped string
# appears in this tracked file. The dashboard now calls these keys "publishable"
# and "secret"; the older "anon" / "service_role" JWTs work in the same variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Live two-user RLS test: same URL and publishable key, plus the secret key.
# Tests run inside the tools container, so 127.0.0.1 is the container itself. Against a
# local stack use the host (SUPABASE_URL=http://host.docker.internal:54321); a hosted
# project uses its own https://<project-ref>.supabase.co URL.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Which Supabase the live integration tests talk to: `hosted` (or unset) uses the
# trio above; `local` uses the trio below, for ./scripts/meditaur up. Run them with
# ./scripts/meditaur test:integration:hosted or ...:local. A target that was named
# but is not configured FAILS rather than skips, so a run cannot claim to have
# covered a database it never reached (tests/fixtures/supabase-target.ts).
SUPABASE_TARGET=

# The host stack, reached from inside the tools container — where 127.0.0.1 is the
# container itself, which is why the URL is the host gateway compose.tools.yaml
# maps. Copy the two keys from `supabase status` after ./scripts/meditaur up.
SUPABASE_LOCAL_URL=http://host.docker.internal:54321
SUPABASE_LOCAL_ANON_KEY=
SUPABASE_LOCAL_SERVICE_ROLE_KEY=
