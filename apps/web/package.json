{
  "name": "@meditaur/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bash ../../scripts/clean-run.sh --keep-next",
    "dev": "next dev --port 3000",
    "prebuild": "rm -rf .next",
    "build": "next build",
    "start": "next start --port 3000",
    "pretest:e2e": "bash ../../scripts/clean-run.sh --keep-next",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --cache",
    "test:unit": "node -e \"process.exit(0)\"",
    "test:e2e": "playwright test --config ../../tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@meditaur/application": "workspace:*",
    "@meditaur/audio-web": "workspace:*",
    "@meditaur/db": "workspace:*",
    "@meditaur/domain": "workspace:*",
    "@meditaur/ui": "workspace:*",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13"
  }
}
