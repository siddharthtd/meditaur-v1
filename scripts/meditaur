#!/usr/bin/env bash
# Project-local entry point. Node/pnpm run in infra/Dockerfile.tools, not on the host.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
CMD="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

run() {
  "${SCRIPT_DIR}/in-docker.sh" "$@"
}

# Where the host stack lives, as seen from inside the tools container. 127.0.0.1
# in there is the container itself, which is why this name exists at all.
LOCAL_STACK_URL="http://host.docker.internal:54321"

# Says whether the host stack is answering, from inside the container the tests
# run in — so "is host.docker.internal still mapped?" has an answer on every live
# run instead of only when someone remembers to run the local target. Never fails
# the run: a stack that is not there only matters to the local target, and that
# target fails on its own with instructions.
probe_local_stack() {
  local url code
  url="${SUPABASE_LOCAL_URL:-}"
  if [[ -z "${url}" ]]; then
    url="$(sed -n 's/^SUPABASE_LOCAL_URL=//p' "${ROOT}/.env" 2>/dev/null | tail -1)"
    url="${url%\"}"
    url="${url#\"}"
  fi
  url="${url:-${LOCAL_STACK_URL}}"
  code="$(run node -e 'fetch(process.argv[1] + "/auth/v1/health").then((r) => console.log(r.status)).catch(() => console.log("down"))' "${url}" 2>/dev/null | tail -1)"
  if [[ "${code}" =~ ^2 ]]; then
    echo "meditaur: local stack at ${url} — answering (${code})."
  else
    echo "meditaur: local stack at ${url} — not answering; ./scripts/meditaur up starts it."
  fi
}

# The local stack's own keys, asked of the CLI, so nobody has to copy them into
# `.env` by hand — which is the step that made "run the local half" feel like
# homework. Falls back to whatever `.env` already holds when the CLI or the stack
# is absent, and the tests fail with instructions when neither produced a trio.
local_credentials() {
  command -v supabase >/dev/null 2>&1 || return 0
  local out api anon service
  out="$(supabase status -o env 2>/dev/null || true)"
  [[ -n "${out}" ]] || return 0
  pick() {
    printf '%s\n' "${out}" | grep -E "^$1=" | tail -1 | cut -d= -f2- | tr -d '"'
  }
  api="$(pick API_URL)"
  anon="$(pick ANON_KEY)"
  [[ -n "${anon}" ]] || anon="$(pick PUBLISHABLE_KEY)"
  service="$(pick SERVICE_ROLE_KEY)"
  [[ -n "${service}" ]] || service="$(pick SECRET_KEY)"
  # 127.0.0.1 in the tools container is the container itself: the tests must be
  # handed the host gateway, whatever the CLI reports locally.
  if [[ -n "${api}" ]]; then
    export SUPABASE_LOCAL_URL="http://host.docker.internal:${api##*:}"
  fi
  if [[ -n "${anon}" && -n "${service}" ]]; then
    export SUPABASE_LOCAL_ANON_KEY="${anon}"
    export SUPABASE_LOCAL_SERVICE_ROLE_KEY="${service}"
    echo "meditaur: local credentials taken from the running stack."
  fi
}

case "${CMD}" in
  setup)
    "${SCRIPT_DIR}/setup.sh"
    ;;
  dev)
    "${ROOT}/scripts/clean-run.sh" --keep-next
    run --publish pnpm --filter @meditaur/web dev "$@"
    ;;
  check)
    run pnpm check "$@"
    ;;
  check:full)
    # Whole gate, orchestrated from the host so e2e keeps its own image. This is
    # the occasional pass, not the edit loop: it covers **both** live databases
    # next to e2e, while `check` stays Supabase-free for the fast one. Supabase
    # still is not required to build or lint — the hosted half skips itself when
    # no keys are configured (which is why CI stays green without secrets), and
    # the local half needs the stack this starts.
    #
    # One gate at a time on one machine. Two gates make **both** e2e readings meaningless:
    # round 24 printed 3 failed / 9 flaky / 89 passed in 14.8m while another session's dev
    # server and suite shared the host, and round 25's subset re-run on the same evening
    # failed the same way — `page.goto: Timeout 30000ms exceeded` and a crashed page in
    # specs that round never opened. So the lock is held for the whole gate and released by
    # the exit trap below, so a stage that fails releases it too; a gate killed mid-flight
    # leaves a dead pid, which the next session takes over (`scripts/session.sh`). The edit
    # loop (`check`) takes no lock and is never blocked.
    # **What the gate costs (`P4 · 57`).** A reading is only worth as much as the machine it
    # was taken on: round 24 printed `3 failed / 9 flaky / 89 passed in 14.8m` on a host at a
    # load average of 12–47, and round 25's subset re-run failed the same way, and both were
    # read as app readings for longer than they should have been. So the gate says which
    # machine it is taking, warns once the load average is above half the cores, shows what
    # the previous run cost stage by stage, and times every stage it runs (`scripts/cost.sh`).
    # A stage that fails still records its seconds: the run that went wrong is the interesting
    # one.
    TIMINGS=()
    stage() {
      local label="$1"
      shift
      local start=${SECONDS} code=0
      "$@" || code=$?
      local elapsed=$((SECONDS - start))
      TIMINGS[${#TIMINGS[@]}]="${label} ${elapsed}"
      printf 'meditaur: %s — %ss\n' "${label}" "${elapsed}"
      return "${code}"
    }
    finish() {
      local line total=0
      if [[ ${#TIMINGS[@]} -gt 0 ]]; then
        for line in "${TIMINGS[@]}"; do
          total=$((total + ${line##* }))
        done
        printf 'meditaur: this run — %ss (total %ss)\n' \
          "$(printf '%s · ' "${TIMINGS[@]}" | sed 's/ · $//')" "${total}"
        printf '%s\n' "${TIMINGS[@]}" | "${SCRIPT_DIR}/cost.sh" save || true
      fi
      # The lock is released from here, so a stage that fails releases it too — and the
      # release is ownership-checked, so it can never clear another session's.
      "${SCRIPT_DIR}/session.sh" release || true
    }
    # The lock is taken **before** the trap is armed, so a gate that is refused never reaches
    # a release at all. Only a gate killed outright leaves a stale file, and a stale file
    # holds a dead pid — which the next session takes over.
    "${SCRIPT_DIR}/session.sh" hold "the gate"
    trap finish EXIT
    export MEDITAUR_PREP_LOCK_HELD=1
    "${SCRIPT_DIR}/cost.sh" machine
    "${SCRIPT_DIR}/cost.sh" show
    # Idempotent: starts the stack if it is down and re-applies the migrations,
    # so the local half is testing this checkout's schema, not a stale one.
    prepare_gate() {
      "${SCRIPT_DIR}/clean-run.sh"
      if command -v supabase >/dev/null 2>&1; then
        "${SCRIPT_DIR}/local-up.sh"
      else
        echo "meditaur: no Supabase CLI on the host; the local half of the live tests cannot run."
        echo "meditaur: ./scripts/meditaur test:integration:hosted covers the hosted project alone."
      fi
    }
    live_databases() {
      local_credentials
      run bash -c 'SUPABASE_TARGET=hosted pnpm test:integration > /tmp/hosted.log 2>&1 & h=$!
      SUPABASE_TARGET=local pnpm test:integration > /tmp/local.log 2>&1 & l=$!
      wait "$h"; hc=$?
      wait "$l"; lc=$?
      # A green suite prints a summary; a **red** one prints its whole log, because
      # vitest prints a failure message above the code frame it prints last, so a
      # short tail keeps the frame and loses the reason. Round 20 lost two red
      # hosted suites that way (`P4 · 42`).
      echo "=== live: hosted (exit ${hc}) ==="
      if [ "${hc}" -eq 0 ]; then tail -n 12 /tmp/hosted.log; else cat /tmp/hosted.log; fi
      echo "=== live: local (exit ${lc}) ==="
      if [ "${lc}" -eq 0 ]; then tail -n 12 /tmp/local.log; else cat /tmp/local.log; fi
      [ "${hc}" -eq 0 ] && [ "${lc}" -eq 0 ]'
    }
    stage "prepare" prepare_gate
    stage "check" run pnpm check
    stage "live databases" live_databases
    stage "build" run pnpm build
    stage "e2e" "${SCRIPT_DIR}/e2e.sh"
    ;;
  test | test:unit)
    run pnpm test:unit "$@"
    ;;
  test:integration)
    probe_local_stack
    run pnpm test:integration "$@"
    ;;
  test:integration:hosted)
    # The hosted project. Fails rather than skips when the trio is missing.
    export SUPABASE_TARGET=hosted
    probe_local_stack
    run pnpm test:integration "$@"
    ;;
  test:integration:local)
    # The host stack, from inside the container, over host.docker.internal.
    # Needs ./scripts/meditaur up first; a dead stack is a failure, not a skip.
    local_credentials
    export SUPABASE_TARGET=local
    probe_local_stack
    run pnpm test:integration "$@"
    ;;
  test:integration:both)
    # Both databases, one container start, at the same time. The two suites share
    # nothing — different database, random ids, their own users — so running them
    # concurrently is free time, and both summaries are printed either way. Needs
    # ./scripts/meditaur up; the local half fails without it rather than skipping.
    local_credentials
    probe_local_stack
    run bash -c 'SUPABASE_TARGET=hosted pnpm test:integration > /tmp/hosted.log 2>&1 & h=$!
      SUPABASE_TARGET=local pnpm test:integration > /tmp/local.log 2>&1 & l=$!
      wait "$h"; hc=$?
      wait "$l"; lc=$?
      # The whole log when it is red — see the note in `check:full` (`P4 · 42`).
      echo "=== hosted (exit ${hc}) ==="
      if [ "${hc}" -eq 0 ]; then tail -n 20 /tmp/hosted.log; else cat /tmp/hosted.log; fi
      echo "=== local (exit ${lc}) ==="
      if [ "${lc}" -eq 0 ]; then tail -n 20 /tmp/local.log; else cat /tmp/local.log; fi
      [ "${hc}" -eq 0 ] && [ "${lc}" -eq 0 ]'
    ;;
  e2e | test:e2e)
    # Optional arguments name a spec or a Playwright filter: the cheap reading of one
    # behaviour, which needs no preparation and is not blocked by another session's gate.
    "${SCRIPT_DIR}/e2e.sh" "$@"
    ;;
  build)
    "${SCRIPT_DIR}/clean-run.sh"
    run pnpm build "$@"
    ;;
  preview)
    "${SCRIPT_DIR}/preview.sh"
    ;;
  up | local:up)
    "${SCRIPT_DIR}/local-up.sh"
    ;;
  down)
    "${SCRIPT_DIR}/down.sh"
    ;;
  cloud)
    # Hosted Supabase: link, push migrations, run the live tests. Host CLI, same
    # exception as `up`.
    "${SCRIPT_DIR}/cloud.sh" "$@"
    ;;
  clean)
    "${SCRIPT_DIR}/clean.sh"
    ;;
  clean:all)
    "${SCRIPT_DIR}/clean.sh"
    rm -rf "${ROOT}/node_modules" "${ROOT}"/apps/*/node_modules "${ROOT}"/packages/*/node_modules
    echo "meditaur: node_modules removed (run ./scripts/meditaur setup)"
    ;;
  clean:tools)
    rm -rf "${ROOT}/.tools"
    echo "meditaur: .tools/ caches removed (run ./scripts/meditaur setup)"
    ;;
  exec)
    run "$@"
    ;;
  help | -h | --help)
    cat <<'EOF'
meditaur — Node/pnpm run in Docker (infra/Dockerfile.tools, node:24.20.0-bookworm-slim)

  ./scripts/meditaur setup             first clone: build the tools image, pnpm install
  ./scripts/meditaur dev               stop leftover preview, then Next.js
  ./scripts/meditaur check             typecheck, lint, unit tests
  ./scripts/meditaur check:full        check + integration + build + e2e (Docker)
                                           one gate at a time: refuses while another
                                           session holds the machine (scripts/session.sh)
  ./scripts/meditaur e2e [spec|args]   the e2e suite, or one spec — no preparation,
                                           never blocked by another session
                                           (MEDITAUR_SESSION=alpha names your own project,
                                           image tag and containers)
  ./scripts/meditaur build             wipe last build, production Next.js build
  ./scripts/meditaur preview           wipe last preview, Docker prod-like image
  ./scripts/meditaur up                host Supabase CLI only; optional (Dexie is the default)
  ./scripts/meditaur cloud             hosted project: link, push migrations, live tests (needs .env)
  ./scripts/meditaur down              stop Docker/supabase leftovers
  ./scripts/meditaur test:integration     live tests against the target .env describes
  ./scripts/meditaur test:integration:both     ... hosted, then the local stack
  ./scripts/meditaur test:integration:hosted   ... against the hosted project
  ./scripts/meditaur test:integration:local    ... against the host stack (needs `up`)
  ./scripts/meditaur e2e               Playwright in Docker (Chromium is in the image)
  ./scripts/meditaur clean             generated files only
  ./scripts/meditaur clean:all         also node_modules
  ./scripts/meditaur clean:tools       remove .tools/ pnpm caches
  ./scripts/meditaur exec <cmd...>     run any command in the tools container
EOF
    ;;
  *)
    echo "meditaur: unknown command '${CMD}'" >&2
    echo "Run ./scripts/meditaur help" >&2
    exit 1
    ;;
esac
